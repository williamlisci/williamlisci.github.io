{
	"name": "blog",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"homepage": "https://williamlisci.github.io/",
	"scripts": {
		"prebuild": "node scripts/generate-posts-index.mjs",
		"predev": "pnpm run normalize-posts",
		"dev": "vite",
		"build": "vite build",
		"lint": "oxlint . --deny-warnings",
		"lint:fix": "oxlint . --fix",
		"format": "prettier --write .",
		"typecheck": "tsc --noEmit",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run build",
		"prepare": "husky",
		"preview": "vite preview",
		"normalize-posts": "node scripts/add-frontmatter.mjs && node scripts/convert-latex-delimiters.mjs && node scripts/generate-posts-index.mjs"
	},
	"dependencies": {
		"@react-three/drei": "^10.7.9",
		"@react-three/fiber": "^9.8.2",
		"@react-three/postprocessing": "^3.2.2",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/vite": "^4.3.5",
		"@types/katex": "^0.16.8",
		"@types/node": "^26.6.6",
		"@types/react-scroll": "^1.8.10",
		"@types/three": "^0.187.0",
		"katex": "^0.19.1",
		"postprocessing": "^6.39.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.18.6",
		"rehype-katex": "^7.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"three": "^0.187.0"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.20",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"autoprefixer": "^10.7.0",
		"fast-glob": "^3.3.3",
		"gray-matter": "^4.0.3",
		"husky": "^9.1.7",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2008",
		"postcss": "^8.5.33",
		"prettier": "^3.10.1",
		"tailwindcss": "^4.3.5",
		"typescript": "~7.0.2",
		"vite": "^8.3.8"
	}
}
